// ==UserScript==
// @name         RTS Copy WO & SN
// @namespace    https://rts.systronics-pr.com/
// @version      1.2
// @description  Copy Work Order and Serial Number from RTS call details
// @author       Angel
// @match        https://rts.systronics-pr.com/RTS/calldetails/*
// @grant        GM_setClipboard
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    function showToast(message) {
        let toast = document.getElementById('rts-copy-toast');

        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'rts-copy-toast';

            toast.style.cssText = `
                position: fixed;
                bottom: 20px;
                right: 20px;
                background: #333;
                color: white;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 14px;
                z-index: 999999;
                box-shadow: 0 2px 8px rgba(0,0,0,.3);
            `;

            document.body.appendChild(toast);
        }

        toast.textContent = message;
        toast.style.display = 'block';

        clearTimeout(toast._timer);

        toast._timer = setTimeout(() => {
            toast.style.display = 'none';
        }, 1500);
    }

    async function copyText(text, label) {
        if (!text) {
            showToast(${label} not found);
            return;
        }

        try {
            await navigator.clipboard.writeText(text);
        } catch (e) {
            if (typeof GM_setClipboard !== 'undefined') {
                GM_setClipboard(text);
            }
        }

        showToast(Copied ${label}: ${text});
    }

    function addWorkOrderButton() {
        const workOrderHeader = [...document.querySelectorAll('h2')]
            .find(h => h.querySelector('.floatright'));

        if (!workOrderHeader) return;

        if (workOrderHeader.querySelector('.wo-copy-btn')) return;

        const btn = document.createElement('button');
        btn.className = 'wo-copy-btn';
        btn.textContent = '📋 WO';

        btn.style.cssText = `
            margin-left:10px;
            padding:4px 10px;
            border:none;
            border-radius:6px;
            background:#0078D4;
            color:white;
            font-size:12px;
            cursor:pointer;
        `;

        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const workOrder =
                workOrderHeader.childNodes[0]?.textContent.trim();

            copyText(workOrder, 'WO');
        });

        workOrderHeader.appendChild(btn);
    }

    function addSerialNumberButton() {
        const serialHeader = [...document.querySelectorAll('h2')]
            .find(h => {
                const span = h.querySelector(
                    'span[data-ng-show="isEquipmentCall()"]'
                );

                return span && span.textContent.trim().length > 0;
            });

        if (!serialHeader) return;

        if (serialHeader.querySelector('.sn-copy-btn')) return;

        const btn = document.createElement('button');
        btn.className = 'sn-copy-btn';
        btn.textContent = '📋 SN';

        btn.style.cssText = `
            margin-left:10px;
            padding:4px 10px;
            border:none;
            border-radius:6px;
            background:#107C10;
            color:white;
            font-size:12px;
            cursor:pointer;
        `;

        btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            // Re-read serial every click (Angular-safe)
            const serial =
                document.querySelector(
                    'span[data-ng-show="isEquipmentCall()"]'
                )?.textContent?.trim();

            copyText(serial, 'SN');
        });

        serialHeader.appendChild(btn);
    }

    function init() {
        addWorkOrderButton();
        addSerialNumberButton();
    }

    init();

    const observer = new MutationObserver(() => {
        init();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();
