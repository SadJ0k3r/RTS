// ==UserScript==
// @name         RemoteTech - Problems/Repairs Searchbox with Autocomplete
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  Adds mobile-friendly autocomplete searchboxes above Problems/Repairs dropdowns, matching real options and selecting them for instant interaction.
// @author       You
// @match        *://rts.systronics-pr.com/RTS/calldetails/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    function injectStyles() {
        if (document.getElementById('dropdownSearchStyles')) return;
        const css = `
            .dropdown-searchbox {
                box-sizing: border-box;
                width: 100%;
                max-width: 460px;
                padding: 0.7em 1.3em;
                font-size: 1.07rem;
                margin-bottom: 8px;
                border-radius: 7px;
                border: 1px solid #cfd8dc;
                background: #f5f7fa;
                box-shadow: 0 2px 7px rgba(44,83,100,0.10);
                transition: border 0.2s, box-shadow 0.2s;
                outline: none;
                display: block;
            }
            .autocomplete-list {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                z-index: 9999;
                background: #fff;
                border: 1px solid #90caf9;
                border-radius: 0 0 6px 6px;
                max-height: 210px;
                overflow-y: auto;
                box-shadow: 0 4px 12px rgba(44,83,100,0.13);
            }
            .autocomplete-item {
                padding: 8px 16px;
                cursor: pointer;
                font-size: 1rem;
                background: #fff;
                transition: background 0.15s;
            }
            .autocomplete-item.active,
            .autocomplete-item:hover {
                background: #90caf9;
                color: #294962;
            }
            @media (max-width: 650px) {
                .dropdown-searchbox { font-size: 0.99rem; max-width: 98vw; padding: 0.51em 0.7em; }
                .autocomplete-list { font-size: 0.98rem; }
            }
        `;
        const style = document.createElement('style');
        style.id = 'dropdownSearchStyles';
        style.innerText = css;
        document.head.appendChild(style);
    }

    // Autocomplete integrated with select options
    function addAutocompleteSearch(selectElem, label) {
        if (!selectElem || selectElem.previousElementSibling?.classList?.contains('dropdown-searchbox')) return;

        // Create search <input>
        const wrapper = document.createElement('div');
        wrapper.style.position = "relative";
        selectElem.parentNode.insertBefore(wrapper, selectElem);

        const search = document.createElement('input');
        search.type = 'search';
        search.className = 'dropdown-searchbox';
        search.placeholder = `🔍 Search ${label}...`;
        search.setAttribute('aria-label', `Autocomplete ${label}`);
        wrapper.appendChild(search);

        wrapper.appendChild(selectElem);

        // Build data from options
        const origOptions = [...selectElem.options].map(opt => ({
            text: opt.textContent || opt.innerText,
            value: opt.value
        }));

        // Create autocomplete list element
        const list = document.createElement('div');
        list.className = 'autocomplete-list';
        list.style.display = 'none';
        wrapper.appendChild(list);

        // Filter function for autocomplete
        function showMatches(q) {
            list.innerHTML = "";
            const matches = origOptions.filter(item => item.text.toLowerCase().includes(q));
            if (!q || matches.length === 0) {
                list.style.display = "none";
                return;
            }
            matches.forEach((item, idx) => {
                const div = document.createElement('div');
                div.className = 'autocomplete-item';
                div.textContent = item.text;
                div.dataset.value = item.value;
                div.tabIndex = 0;
                div.onclick = function () {
                    // Match selected
                    selectElem.value = item.value;
                    selectElem.dispatchEvent(new Event('input', { bubbles:true }));
                    selectElem.dispatchEvent(new Event('change', { bubbles:true }));
                    list.style.display = "none";
                    search.value = item.text;
                };
                list.appendChild(div);
            });
            list.style.display = "block";
        }

        // Key support
        let activeIdx = -1;
        search.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            activeIdx = -1;
            showMatches(q);
        });

        search.addEventListener('keydown', function (e) {
            const items = list.querySelectorAll('.autocomplete-item');
            if (e.key === "ArrowDown" && items.length) {
                e.preventDefault();
                activeIdx = Math.min(activeIdx+1, items.length-1);
                items.forEach(x => x.classList.remove('active'));
                if (items[activeIdx]) items[activeIdx].classList.add('active');
                items[activeIdx]?.focus();
            }
            if (e.key === "ArrowUp" && items.length) {
                e.preventDefault();
                activeIdx = Math.max(activeIdx-1, 0);
                items.forEach(x => x.classList.remove('active'));
                if (items[activeIdx]) items[activeIdx].classList.add('active');
                items[activeIdx]?.focus();
            }
            if (e.key === "Enter" && items[activeIdx]) {
                items[activeIdx].click();
            }
            if (e.key === "Escape") {
                list.style.display = "none";
            }
        });

        document.addEventListener('click', function(e){
            if (!wrapper.contains(e.target)) list.style.display = "none";
        });

        selectElem.addEventListener('change', function () {
            search.value = selectElem.options[selectElem.selectedIndex]?.text || '';
            list.style.display = "none";
        });
    }

    function setupDropdownAutocompletes() {
        injectStyles();

        const selects = Array.from(document.querySelectorAll('select'));
        const problemSelect = selects.find(sel =>
            sel.options[0]?.textContent?.toLowerCase().includes('choose problem'));
        const repairSelect = selects.find(sel =>
            sel.options[0]?.textContent?.toLowerCase().includes('choose repair'));

        addAutocompleteSearch(problemSelect, 'Problem');
        addAutocompleteSearch(repairSelect, 'Repair');
    }

    new MutationObserver(setupDropdownAutocompletes)
        .observe(document.body, { childList: true, subtree: true });
    setupDropdownAutocompletes();
})();
